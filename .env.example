# Copy to .env (never commit .env).
# openai = OpenAI-compatible /chat/completions (default); anthropic = Messages API
# Local use: put these lines in ~/.hotar/ai.env instead (read by `pnpm ai` and by the desktop app at launch).
# Meta Model API (Muse Spark, OpenAI-compatible): LLM_API_URL=https://api.meta.ai/v1, LLM_MODEL=muse-spark-1.3,
# LLM_REASONING_EFFORT=minimal (reasoning models: hidden reasoning tokens count against max_tokens).
LLM_PROVIDER=openai
LLM_API_URL=https://your-llm-api.example.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_REASONING_EFFORT=
# optional advisor tuning (server only)
HOTAR_PROMPTS_DIR=prompts
HOTAR_RATE_LIMIT_PER_HOUR=20
# Server Rust (Axum)
SERVER_PORT=8787
ALLOWED_ORIGINS=http://localhost:3000
# Frontend (Next.js): public values only, no secrets
NEXT_PUBLIC_API_URL=http://localhost:8787
# Data pipeline (optional)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
NASS_API_KEY=

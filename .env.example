# Copiază în .env (NU face commit la .env). Valorile reale le are Albert.
# openai = OpenAI-compatible /chat/completions (default); anthropic = Messages API
LLM_PROVIDER=openai
LLM_API_URL=https://your-llm-api.example.com/v1
LLM_API_KEY=
LLM_MODEL=
# optional advisor tuning (server only)
HOTAR_PROMPTS_DIR=prompts
HOTAR_RATE_LIMIT_PER_HOUR=20
# Server Rust (Axum)
SERVER_PORT=8787
ALLOWED_ORIGINS=http://localhost:3000
# Frontend (Next.js) – doar valori publice, fără secrete
NEXT_PUBLIC_API_URL=http://localhost:8787
# Pipeline de date (opțional)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
NASS_API_KEY=

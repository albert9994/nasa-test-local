{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: local store, pack cache in the app data folder, save dialogs, open links",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "store:default",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-confirm",
    "opener:default",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$APPDATA" }, { "path": "$APPDATA/**" }]
    }
  ]
}

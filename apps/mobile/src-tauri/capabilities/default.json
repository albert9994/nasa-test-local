{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "default",
  "description": "Main webview: local store, pack cache in the app data folder, open links",
  "windows": ["main"],
  "platforms": ["iOS", "android", "macOS", "windows", "linux"],
  "permissions": [
    "core:default",
    "store:default",
    "opener:default",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$APPDATA" }, { "path": "$APPDATA/**" }]
    }
  ]
}

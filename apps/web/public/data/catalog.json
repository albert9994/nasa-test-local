      "url": "https://soilgrids.org/",
      "resolution": "250 m, 5 depths to 1 m",
      "period": "static (modelled from 2020 observations)",
      "usedFor": "Water-holding capacity, runoff, erodibility, carbon, pH",
      "status": "real"
    },
    {
      "id": "srtm",
      "name": "SRTM elevation and slope",

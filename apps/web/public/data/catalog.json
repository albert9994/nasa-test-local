      "url": "https://power.larc.nasa.gov/",
      "resolution": "0.5 x 0.625 deg grid, daily",
      "period": "2001-2025",
      "usedFor": "Daily Tmax/Tmin, rain, root-zone wetness, radiation, humidity, wind for the crop-water simulation",
      "status": "real"
    },
    {
      "id": "modis_ndvi",
      "name": "MODIS Terra NDVI (MOD13Q1 v061)",
      "nameRo": "NDVI MODIS Terra (MOD13Q1 v061)",
      "provider": "NASA LP DAAC via ORNL DAAC MODIS subsets",
      "url": "https://modis.ornl.gov/data/modis_webservice.html",
      "resolution": "250 m pixel at the farm point, 16-day composite",
      "period": "2001-2025 (growing season, DOY 113-257)",
      "usedFor": "Satellite greenness in the drought replay and yield validation; cloudy/snow pixels masked",
      "status": "real"
    },
    {
      "id": "nex_gddp_cmip6",
      "name": "NEX-GDDP-CMIP6 climate projections",
      "nameRo": "Proiecții climatice NEX-GDDP-CMIP6",
